# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# These five ship to the browser — Vite inlines every VITE_-prefixed variable
# into the bundle. That is fine and intended: they identify the Firebase project,
# they are not secrets, and what a signed-in user can actually read or write is
# decided by firebase/firestore.rules and firebase/storage.rules, not by keeping
# these values hidden. Copy them from Firebase console → Project settings → Your
# apps → the web app's config.
#
# A SERVICE-ACCOUNT KEY is the opposite. It bypasses the rules completely. It must
# never appear in this file, never carry a VITE_ prefix, and never reach the
# frontend — it belongs only on the backup host. See docs/BACKUP.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Optional. Where the Cloud Functions are deployed; must match REGION in
# functions/index.js. Defaults to us-west1.
# VITE_FIREBASE_FUNCTIONS_REGION=us-west1

# Optional — build-time only, used by scripts/fetch-tba.mjs. Not exposed to the
# browser precisely because it has no VITE_ prefix.
#
# The name must be exactly TBA_KEY: that is what fetch-tba.mjs reads. (The portal's
# own Blue Alliance calls go through the tbaProxy function, whose key is a
# Functions secret, not this file.)
TBA_KEY=
