{
  "name": "frc5805-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Official website of FRC Team 5805 \u2014 SMbly Required, Santa Margarita Catholic High School.",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators --port 5174 --strictPort",
    "emulators": "firebase emulators:start --project demo-frc5805",
    "seed:emulators": "node scripts/firebase/seed-emulators.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:tba": "node scripts/fetch-tba.mjs",
    "deploy": "node scripts/fetch-tba.mjs && vite build && npx gh-pages -d dist -m \"Deploy site\"",
    "test:markdown": "node scripts/test/markdown-safety.mjs",
    "test:portal": "node scripts/test/portal.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-frc5805 \"node --test firebase/test/rules.test.mjs\"",
    "test:functions": "firebase --config firebase.functions-test.json emulators:exec --project demo-frc5805 \"node --test functions/test/*.test.mjs\"",
    "test": "npm run test:markdown && npm run test:portal && npm run test:rules && npm run test:functions",
    "deploy:backend": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "seed:demo": "node scripts/firebase/seed-demo.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "split-type": "^0.3.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "meshoptimizer": "^1.3.0",
    "vite": "^6.0.7"
  }
}
