{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", "test"]
    }
  ],
  "emulators": {
    "auth": { "port": 9190 },
    "firestore": { "port": 8180 },
    "storage": { "port": 9290 },
    "functions": { "port": 5101 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
